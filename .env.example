# ============================================================
#  环境变量模板
#  用法：复制成 .env 然后填入真实值
#       cp .env.example .env
#  ⚠️ .env 绝对不能提交到 Git（已在 .gitignore 里排除）
# ============================================================

# ── LLM（必填）────────────────────────────────────────────
# 默认用 DeepSeek，便宜且 OpenAI 接口兼容
# 申请地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-在这里填你的key

# 如果想换别的 OpenAI 兼容服务，改这两个即可：
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ── 本地服务（docker compose up -d 会自动起）──────────────
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# ── 可选：关闭 Redis 缓存（用于对比实验）──────────────────
# CACHE_ENABLED=false

# ── HuggingFace 镜像（下载 BGE 模型用，强烈建议保留）────────
# fastembed 首次运行要从 HuggingFace 拉 ONNX 模型（约 70MB），
# 直连国内很慢，走这个镜像站快得多。
HF_ENDPOINT=https://hf-mirror.com

# ⭐ 禁用 HF 的 Xet 存储后端
# 原因：Xet 会 302 重定向到 cas-server.xethub.hf.co，
#      而 hf-mirror 不代理那个后端，会返回 401 导致下载失败。
#      禁用后退回普通 /resolve/ 下载，镜像站能正常代理。
HF_HUB_DISABLE_XET=1
